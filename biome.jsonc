{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!**/.cache"] },
  // The house style: two spaces, single quotes, long lines.
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "style": {
        // With noUncheckedIndexedAccess on, `items[i]!` is how we say "this index exists".
        "noNonNullAssertion": "off",
        // style.css is organised by component; this rule compares selectors across unrelated ones.
        "noDescendingSpecificity": "off"
      }
    }
  }
}
